{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','gate.py'),run_name='__main__')\"",
            "commandWindows": "python -c \"import os,runpy;runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'scripts','gate.py'),run_name='__main__')\"",
            "timeout": 120,
            "statusMessage": "Effort Fit Pro: Lunaでeffortを審査中",
            "async": false
          }
        ]
      }
    ]
  }
}
